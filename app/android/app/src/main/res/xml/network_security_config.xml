<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for WAPDA Alert.
  
  Cleartext (HTTP) traffic is denied globally, EXCEPT to 192.168.4.1
  which is the ESP32's SoftAP IP used during device setup (captive portal).
  All other traffic (including wss:// WebSocket) uses TLS.
-->
<network-security-config>
  <!-- Since local WSS is not viable, we must allow cleartext (ws:// and http://) 
       so the app can talk to the ESP32 dynamically on the local home network. 
       Android does not support allowing IP ranges (like 192.168.*.*). -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
